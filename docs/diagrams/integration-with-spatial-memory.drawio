        <!-- Extraction Results -->
        <mxCell id="results" value="&lt;b&gt;Extraction Results&lt;/b&gt;&lt;br&gt;(per-field values + confidence)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="460" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Arrow: Spatial Extract → Results -->
        <mxCell id="edge-spatial-results" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="spatial-extract" target="results" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrow: Bedrock → Results -->
        <mxCell id="edge-bedrock-results" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="bedrock" target="results" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- QA Human Review -->
        <mxCell id="qa-review" value="&lt;b&gt;QA Review&lt;/b&gt;&lt;br&gt;Human corrections" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="580" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Arrow: Results → QA -->
        <mxCell id="edge-results-qa" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="results" target="qa-review" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Feedback arrows back to memories -->
        <!-- Arrow: QA → Correction Log -->
        <mxCell id="edge-qa-corrections" value="Corrections feed&lt;br&gt;semantic memory" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#b85450;" edge="1" source="qa-review" target="correction-log" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
