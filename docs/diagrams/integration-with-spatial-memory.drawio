<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2024-01-01T00:00:00.000Z" agent="benchmark" version="22.1.0" type="device">
  <diagram id="integration-spatial-memory" name="Integration with Spatial Memory">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Dual-Memory Architecture: Semantic Correction + Spatial Field Memory&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="600" height="40" as="geometry" />
        </mxCell>

        <!-- Document Input -->
        <mxCell id="doc-input" value="&lt;b&gt;Document&lt;/b&gt;&lt;br&gt;(PDF/Image)" style="shape=document;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="120" height="80" as="geometry" />
        </mxCell>

        <!-- OCR / Textract -->
        <mxCell id="textract" value="&lt;b&gt;Amazon Textract&lt;/b&gt;&lt;br&gt;OCR + Layout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="130" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- Arrow: Doc → Textract -->
        <mxCell id="edge-doc-textract" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="doc-input" target="textract" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Spatial Memory Check -->
        <mxCell id="spatial-check" value="&lt;b&gt;textract-field-memory&lt;/b&gt;&lt;br&gt;Spatial Confidence Check&lt;br&gt;&lt;i&gt;(positional memory)&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="100" width="200" height="120" as="geometry" />
        </mxCell>

        <!-- Arrow: Textract → Spatial Check -->
        <mxCell id="edge-textract-spatial" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="textract" target="spatial-check" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- High Spatial Confidence Path -->
        <mxCell id="spatial-extract" value="&lt;b&gt;Extract by Position&lt;/b&gt;&lt;br&gt;(Zero LLM Cost)&lt;br&gt;Bounding box lookup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="300" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- Arrow: Spatial Check → Extract by Position (High Confidence) -->
        <mxCell id="edge-spatial-high" value="&lt;b&gt;High Spatial&lt;br&gt;Confidence&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;" edge="1" source="spatial-check" target="spatial-extract" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Low Spatial Confidence Path → Self-Healing -->
        <mxCell id="self-healing" value="&lt;b&gt;prompt-memory&lt;/b&gt;&lt;br&gt;Confidence Router&lt;br&gt;&lt;i&gt;(semantic correction memory)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="100" width="200" height="120" as="geometry" />
        </mxCell>

        <!-- Arrow: Spatial Check → Self-Healing (Low Confidence) -->
        <mxCell id="edge-spatial-low" value="&lt;b&gt;Low Spatial&lt;br&gt;Confidence&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;" edge="1" source="spatial-check" target="self-healing" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Correction Log -->
        <mxCell id="correction-log" value="&lt;b&gt;Correction Log&lt;/b&gt;&lt;br&gt;(DynamoDB)&lt;br&gt;Field-level corrections" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;size=10;" vertex="1" parent="1">
          <mxGeometry x="820" y="300" width="130" height="80" as="geometry" />
        </mxCell>

        <!-- Arrow: Self-Healing ↔ Correction Log -->
        <mxCell id="edge-healing-corrections" value="Query corrections&lt;br&gt;(few-shot examples)" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="self-healing" target="correction-log" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Bedrock LLM -->
        <mxCell id="bedrock" value="&lt;b&gt;Amazon Bedrock&lt;/b&gt;&lt;br&gt;Haiku → Sonnet&lt;br&gt;(confidence-gated)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1050" y="130" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- Arrow: Self-Healing → Bedrock -->
