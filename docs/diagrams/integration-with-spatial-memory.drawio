              <mxPoint x="1020" y="340" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Spatial Memory Store -->
        <mxCell id="spatial-store" value="&lt;b&gt;Spatial Memory&lt;/b&gt;&lt;br&gt;(DynamoDB)&lt;br&gt;Position confidence" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;size=10;" vertex="1" parent="1">
          <mxGeometry x="350" y="300" width="130" height="80" as="geometry" />
        </mxCell>

        <!-- Arrow: QA → Spatial Store -->
        <mxCell id="edge-qa-spatial" value="Results feed&lt;br&gt;positional memory" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#9673a6;" edge="1" source="qa-review" target="spatial-store" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="415" y="610" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Arrow: Spatial Store → Spatial Check -->
        <mxCell id="edge-store-check" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#9673a6;" edge="1" source="spatial-store" target="spatial-check" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Legend Box -->
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;─── Data flow&lt;br&gt;- - - Feedback loop&lt;br&gt;&lt;span style='color:#9673a6'&gt;Purple: Spatial memory path&lt;/span&gt;&lt;br&gt;&lt;span style='color:#b85450'&gt;Red: Semantic correction path&lt;/span&gt;&lt;br&gt;&lt;span style='color:#82b366'&gt;Green: Output / zero-cost path&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="450" width="220" height="120" as="geometry" />
        </mxCell>

        <!-- Rule Graduation -->
